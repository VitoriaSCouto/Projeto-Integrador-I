//ROUTE.HTTP tem a função de testar as ROTAS URL.
//NÃO é necessario para o código,
//necessario apenas para manter sanidade mental

// --------------------------
// Abrigos

POST http://localhost:3000/api/abrigos/cadastrar
Content-Type: application/json

{
  "nome": "Abrigo Teste",
  "endereco": "Rua Teste, 123",
  "telefone": "12123456789",
  "responsavel": "João Abrigos",
  "tipoAbrigo": "emergencial",
  "capacidadeTotal": 50,
  "capacidadeOcupada": 20,
  "possuiAtendimentoMedico": false,
  "status": "ativo"
}

###

GET http://localhost:3000/api/abrigos/listar

###

GET http://localhost:3000/api/abrigos/listar?nome=Teste
// GET com filtro por nome

###

GET http://localhost:3000/api/abrigos/listar?endereco=Rua
// GET com filtro por endereco

###

PUT http://localhost:3000/api/abrigos/atualizar/3
Content-Type: application/json

{
  "nome": "Abrigo Teste Atualizado",
  "endereco": "Rua Teste, 123",
  "telefone": "12123456789",
  "responsavel": "João Abrigos",
  "tipoAbrigo": "emergencial",
  "capacidadeTotal": 50,
  "capacidadeOcupada": 30,
  "possuiAtendimentoMedico": false,
  "status": "ativo"
}

###

DELETE http://localhost:3000/api/abrigos/excluir/3


###


