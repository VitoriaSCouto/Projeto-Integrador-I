// Regioes

POST http://localhost:3000/api/regioes/cadastrar
Content-Type: application/json

{
  "bairro": "Centro",
  "cidade": "Caçapava",
  "estado": "SP",
  "populacaoEstimada": 40000,
  "areaKm2": 12.5,
  "nivelRisco": "medio",
  "statusAlerta": true
}

###

GET http://localhost:3000/api/regioes/listar

###

GET http://localhost:3000/api/regioes/listar?cidade=Taubaté
// GET com filtro por cidade

###

GET http://localhost:3000/api/regioes/listar?bairro=Centro
// GET com filtro por bairro

###

PUT http://localhost:3000/api/regioes/atualizar/1
Content-Type: application/json

{
  "bairro": "Centro",
  "cidade": "Taubaté",
  "estado": "SP",
  "populacaoEstimada": 55000,
  "areaKm2": 12.5,
  "nivelRisco": "medio",
  "statusAlerta": false
}

###

DELETE http://localhost:3000/api/regioes/excluir/1
