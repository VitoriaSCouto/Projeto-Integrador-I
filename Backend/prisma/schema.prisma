generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id          Int      @id @default(autoincrement())
  nome        String
  email       String   @unique
  senha       String
  cargo       String   @default("operador")
  orgao       String?
  nivelAcesso String   @default("operador")
  createdAt   DateTime @default(now()) @map("created_at")

  solicitacoesAnalisadas SolicitacaoAbrigo[]

  @@map("admin")
}

model Regiao {
  id_regiao         Int      @id @default(autoincrement())
  bairro            String
  cidade            String
  estado            String
  populacaoEstimada Int?
  areaKm2           Float?
  nivelRisco        String   @default("baixo")
  statusAlerta      Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  abrigos Abrigo[]

  @@map("regiao")
}

model Abrigo {
  id_abrigo               Int      @id @default(autoincrement())
  nome                    String
  cep                     String   @db.VarChar(9)
  endereco                String
  cidade                  String
  estado                  String
  bairro                  String?
  latitude                Float?
  longitude               Float?
  telefone                String?
  responsavel             String?
  tipoAbrigo              String
  capacidadeTotal         Int
  capacidadeOcupada       Int      @default(0)
  possuiAtendimentoMedico Boolean  @default(false)
  possuiEnfermagem        Boolean  @default(false)
  possuiPets              Boolean  @default(false)
  possuiAcessibilidade    Boolean  @default(false)
  possuiCozinha           Boolean  @default(false)
  fotoAbrigo              String?
  status                  String   @default("ativo")
  createdAt               DateTime @default(now()) @map("created_at")

  regiaoId    Int?
  regiao      Regiao?      @relation(fields: [regiaoId], references: [id_regiao])

  solicitacao SolicitacaoAbrigo?
  vitimas     Vitima[]
  voluntarios Voluntario[]
  doacoes     Doacao[]

  @@map("abrigo")
}

model Vitima {
  id_vitima      Int      @id @default(autoincrement())
  nome           String
  cpf            String?  @db.VarChar(14)
  telefone       String?  @unique @db.VarChar(15)
  dataNascimento DateTime @db.Date
  genero         String
  fotoVitima     String?
  createdAt      DateTime @default(now()) @map("created_at")

  abrigoId Int?
  abrigo   Abrigo? @relation(fields: [abrigoId], references: [id_abrigo])

  deficiencias VitimaDeficiencia[]

}

model Deficiencia {
  id_deficiencia Int    @id @default(autoincrement())
  nome           String @unique

  vitimas VitimaDeficiencia[]

  @@map("deficiencia")
}

model VitimaDeficiencia {
  id_vitima      Int
  id_deficiencia Int

  vitima      Vitima      @relation(fields: [id_vitima], references: [id_vitima])
  deficiencia Deficiencia @relation(fields: [id_deficiencia], references: [id_deficiencia])

  @@id([id_vitima, id_deficiencia])
}

model Voluntario {
  id_voluntario  Int      @id @default(autoincrement())
  nome           String
  cpf            String?  @db.VarChar(14)
  telefone       String?  @db.VarChar(15)
  email          String   @unique
  senha          String
  dataNascimento DateTime @db.Date
  genero         String
  status         String   @default("ativo")
  createdAt      DateTime @default(now()) @map("created_at")

  abrigoId Int?
  abrigo   Abrigo? @relation(fields: [abrigoId], references: [id_abrigo])

  doacoes  Doacao[]

  @@map("voluntario")
}

model Doacao {
  id_doacao      Int      @id @default(autoincrement())
  doadorNome     String
  doadorTelefone String?  @db.VarChar(15)
  tipo           String
  quantidade     String
  descricao      String?
  status         String   @default("pendente")
  createdAt      DateTime @default(now()) @map("created_at")

  abrigoId Int?
  abrigo   Abrigo? @relation(fields: [abrigoId], references: [id_abrigo])

  voluntarioId Int?
  voluntario   Voluntario? @relation(fields: [voluntarioId], references: [id_voluntario])

  @@map("doacao")
}

enum StatusSolicitacao {
  pendente
  aprovado
  recusado
}

model SolicitacaoAbrigo {
  id_solicitacao Int @id @default(autoincrement())

  nome                    String
  cep                     String  @db.VarChar(9)
  endereco                String
  cidade                  String
  estado                  String
  bairro                  String
  telefone                String? @db.VarChar(15)
  responsavel             String
  tipoAbrigo              String
  capacidadeTotal         Int
  possuiAtendimentoMedico Boolean @default(false)
  possuiEnfermagem        Boolean @default(false)
  possuiPets              Boolean @default(false)
  possuiAcessibilidade    Boolean @default(false)
  possuiCozinha           Boolean @default(false)
  fotoAbrigo              String?

  solicitanteNome     String
  solicitanteEmail    String
  solicitanteTelefone String? @db.VarChar(15)

  status       StatusSolicitacao @default(pendente)
  motivoRecusa String?

  analisadoPorId Int?
  analisadoPor   Admin?    @relation(fields: [analisadoPorId], references: [id])
  dataAnalise    DateTime?

  abrigo_id Int?    @unique
  abrigo    Abrigo? @relation(fields: [abrigo_id], references: [id_abrigo])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("solicitacao_abrigo")
}