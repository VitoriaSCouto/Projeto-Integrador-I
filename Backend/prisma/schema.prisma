generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────

model Admin {
  id          Int      @id @default(autoincrement())
  nome        String
  email       String   @unique
  senha       String
  cargo       String   @default("operador")
  orgao       String?
  nivelAcesso String   @default("operador")
  createdAt   DateTime @default(now()) @map("created_at")

  solicitacoesAnalisadas   SolicitacaoAbrigo[]
  solicitacoesAjudaCriadas SolicitacaoAjuda[]  @relation("SolicitacoesAjudaCriadas")

  @@map("admin")
}

// ─────────────────────────────────────────────
// REGIÃO
// ─────────────────────────────────────────────

model Regiao {
  id_regiao         Int      @id @default(autoincrement())
  bairro            String
  cidade            String
  estado            String
  populacaoEstimada Int?
  areaKm2           Float?
  nivelRisco        String   @default("baixo")
  statusAlerta      Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  abrigos Abrigo[]

  @@map("regiao")
}

// ─────────────────────────────────────────────
// ABRIGO
// ─────────────────────────────────────────────

model Abrigo {
  id_abrigo               Int      @id @default(autoincrement())
  nome                    String
  cep                     String   @db.VarChar(9)
  endereco                String
  cidade                  String
  estado                  String
  bairro                  String?
  latitude                Float?
  longitude               Float?
  telefone                String?
  responsavel             String?
  tipoAbrigo              String
  capacidadeTotal         Int
  capacidadeOcupada       Int      @default(0)
  possuiAtendimentoMedico Boolean  @default(false)
  possuiEnfermagem        Boolean  @default(false)
  possuiPets              Boolean  @default(false)
  possuiAcessibilidade    Boolean  @default(false)
  possuiCozinha           Boolean  @default(false)
  fotoAbrigo              String?
  status                  String   @default("ativo")
  createdAt               DateTime @default(now()) @map("created_at")

  regiaoId Int?
  regiao   Regiao? @relation(fields: [regiaoId], references: [id_regiao])

  solicitacao       SolicitacaoAbrigo?
  vitimas           Vitima[]
  voluntarios       Voluntario[]
  solicitacoesAjuda SolicitacaoAjuda[]

  @@map("abrigo")
}

// ─────────────────────────────────────────────
// VÍTIMA
// ─────────────────────────────────────────────

model Vitima {
  id_vitima      Int       @id @default(autoincrement())
  nome           String
  cpf            String?   @db.VarChar(14)
  telefone       String?   @unique @db.VarChar(15)
  dataNascimento DateTime  @db.Date
  genero         String
  fotoVitima     String?
  dataEntrada    DateTime? @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  abrigoId Int?
  abrigo   Abrigo? @relation(fields: [abrigoId], references: [id_abrigo])

  deficiencias VitimaDeficiencia[]
}

model Deficiencia {
  id_deficiencia Int    @id @default(autoincrement())
  nome           String @unique

  vitimas VitimaDeficiencia[]
}

model VitimaDeficiencia {
  id_vitima      Int
  id_deficiencia Int

  vitima      Vitima      @relation(fields: [id_vitima], references: [id_vitima])
  deficiencia Deficiencia @relation(fields: [id_deficiencia], references: [id_deficiencia])

  @@id([id_vitima, id_deficiencia])
}

// ─────────────────────────────────────────────
// VOLUNTÁRIO
// ─────────────────────────────────────────────

model Voluntario {
  id_voluntario  Int      @id @default(autoincrement())
  nome           String
  cpf            String?  @db.VarChar(14)
  telefone       String?  @db.VarChar(15)
  email          String   @unique
  senha          String
  dataNascimento DateTime @db.Date
  genero         String
  status         String   @default("ativo")
  createdAt      DateTime @default(now()) @map("created_at")

  abrigoId Int?
  abrigo   Abrigo? @relation(fields: [abrigoId], references: [id_abrigo])

  solicitacoesAjudaAtendidas SolicitacaoAjuda[]
  interessesAjuda            SolicitacaoAjudaInteresse[]

  @@map("voluntario")
}

// ─────────────────────────────────────────────
// SOLICITAÇÃO DE ABRIGO
// ─────────────────────────────────────────────

enum StatusSolicitacao {
  pendente
  aprovado
  recusado
}

model SolicitacaoAbrigo {
  id_solicitacao Int @id @default(autoincrement())

  nome                    String
  cep                     String  @db.VarChar(9)
  endereco                String
  cidade                  String
  estado                  String
  bairro                  String
  telefone                String? @db.VarChar(15)
  responsavel             String
  tipoAbrigo              String
  capacidadeTotal         Int
  possuiAtendimentoMedico Boolean @default(false)
  possuiEnfermagem        Boolean @default(false)
  possuiPets              Boolean @default(false)
  possuiAcessibilidade    Boolean @default(false)
  possuiCozinha           Boolean @default(false)
  fotoAbrigo              String?

  solicitanteNome     String
  solicitanteEmail    String
  solicitanteTelefone String? @db.VarChar(15)

  status       StatusSolicitacao @default(pendente)
  motivoRecusa String?

  analisadoPorId Int?
  analisadoPor   Admin?    @relation(fields: [analisadoPorId], references: [id])
  dataAnalise    DateTime?

  abrigo_id Int?    @unique
  abrigo    Abrigo? @relation(fields: [abrigo_id], references: [id_abrigo])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("solicitacao_abrigo")
}

// ─────────────────────────────────────────────
// SOLICITAÇÃO DE AJUDA  (substitui Doacao)
// ─────────────────────────────────────────────

enum StatusSolicitacaoAjuda {
  aberto
  em_andamento
  concluido
  cancelado
}

enum CategoriaAjuda {
  doacao         // roupas, alimentos, itens em geral
  medicamento    // remédios, insumos médicos
  voluntariado   // mão de obra, serviços presenciais
  infraestrutura // reparos, equipamentos
  outro          // pedido livre / personalizado
}

enum UrgenciaAjuda {
  baixa
  media
  alta
  critica
}

model SolicitacaoAjuda {
  id_solicitacao Int @id @default(autoincrement())

  // Conteúdo livre — o ADM descreve o que precisa
  titulo    String
  descricao String
  categoria CategoriaAjuda
  urgencia  UrgenciaAjuda  @default(media)

  status StatusSolicitacaoAjuda @default(aberto)

  // Observação interna preenchida ao concluir ou cancelar
  observacaoFechamento String?

  // ADM que criou a solicitação
  criadoPorId Int
  criadoPor   Admin @relation("SolicitacoesAjudaCriadas", fields: [criadoPorId], references: [id])

  // Abrigo ao qual a solicitação pertence (sempre obrigatório)
  abrigoId Int
  abrigo   Abrigo @relation(fields: [abrigoId], references: [id_abrigo])

  // Voluntário que atendeu — preenchido opcionalmente ao concluir
  // Pode ficar nulo (anônimo ou sem vínculo)
  voluntarioId Int?
  voluntario   Voluntario? @relation(fields: [voluntarioId], references: [id_voluntario])

  interesses SolicitacaoAjudaInteresse[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt       @map("updated_at")

  @@index([status])
  @@index([abrigoId])
  @@index([categoria])
  @@index([createdAt])
  @@map("solicitacao_ajuda")
}

// Registro de interesse do voluntário
// — somente visual, sem poder de gestão
// — um voluntário não pode marcar interesse duas vezes na mesma solicitação
model SolicitacaoAjudaInteresse {
  id Int @id @default(autoincrement())

  solicitacaoId Int
  solicitacao   SolicitacaoAjuda @relation(fields: [solicitacaoId], references: [id_solicitacao])

  voluntarioId Int
  voluntario   Voluntario @relation(fields: [voluntarioId], references: [id_voluntario])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([solicitacaoId, voluntarioId])
  @@map("solicitacao_ajuda_interesse")
}
