generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────

model Admin {
  alertasCriados Alerta[] @relation("AlertasCriados")
  historicoAlertas HistoricoAlerta[] @relation("HistoricoAlertasAtor")
  id          Int      @id @default(autoincrement())
  nome        String
  email       String   @unique
  senha       String
  cargo       String   @default("operador")
  orgao       String?
  nivelAcesso String   @default("operador")
  createdAt   DateTime @default(now()) @map("created_at")

  solicitacoesAnalisadas   SolicitacaoAbrigo[]
  solicitacoesAjudaCriadas SolicitacaoAjuda[]  @relation("SolicitacoesAjudaCriadas")

  @@map("admin")
}

// ─────────────────────────────────────────────
// REGIÃO
// ─────────────────────────────────────────────

model Regiao {
  alertas Alerta[]
  inscricoesAlerta InscricaoAlerta[]
  id_regiao         Int      @id @default(autoincrement())
  bairro            String
  cidade            String
  estado            String
  populacaoEstimada Int?
  areaKm2           Float?
  nivelRisco        String   @default("baixo")
  statusAlerta      Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  abrigos Abrigo[]

  @@map("regiao")
}

// ─────────────────────────────────────────────
// ABRIGO
// ─────────────────────────────────────────────

model Abrigo {
  id_abrigo               Int      @id @default(autoincrement())
  nome                    String
  cep                     String   @db.VarChar(9)
  endereco                String
  cidade                  String
  estado                  String
  bairro                  String?
  latitude                Float?
  longitude               Float?
  telefone                String?
  responsavel             String?
  tipoAbrigo              String
  capacidadeTotal         Int
  capacidadeOcupada       Int      @default(0)
  possuiAtendimentoMedico Boolean  @default(false)
  possuiEnfermagem        Boolean  @default(false)
  possuiPets              Boolean  @default(false)
  possuiAcessibilidade    Boolean  @default(false)
  possuiCozinha           Boolean  @default(false)
  fotoAbrigo              String?
  status                  String   @default("ativo")
  createdAt               DateTime @default(now()) @map("created_at")

  regiaoId Int?
  regiao   Regiao? @relation(fields: [regiaoId], references: [id_regiao])

  solicitacao       SolicitacaoAbrigo?
  vitimas           Vitima[]
  voluntarios       Voluntario[]
  solicitacoesAjuda SolicitacaoAjuda[]

  @@map("abrigo")
}

// ─────────────────────────────────────────────
// VÍTIMA
// ─────────────────────────────────────────────

model Vitima {
  id_vitima      Int       @id @default(autoincrement())
  nome           String
  cpf            String?   @db.VarChar(14)
  telefone       String?   @unique @db.VarChar(15)
  dataNascimento DateTime  @db.Date
  genero         String
  fotoVitima     String?
  dataEntrada    DateTime? @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  abrigoId Int?
  abrigo   Abrigo? @relation(fields: [abrigoId], references: [id_abrigo])

  deficiencias VitimaDeficiencia[]
}

model Deficiencia {
  id_deficiencia Int    @id @default(autoincrement())
  nome           String @unique

  vitimas VitimaDeficiencia[]
}

model VitimaDeficiencia {
  id_vitima      Int
  id_deficiencia Int

  vitima      Vitima      @relation(fields: [id_vitima], references: [id_vitima])
  deficiencia Deficiencia @relation(fields: [id_deficiencia], references: [id_deficiencia])

  @@id([id_vitima, id_deficiencia])
}

// ─────────────────────────────────────────────
// VOLUNTÁRIO
// ─────────────────────────────────────────────

model Voluntario {
  id_voluntario  Int      @id @default(autoincrement())
  nome           String
  cpf            String?  @db.VarChar(14)
  telefone       String?  @db.VarChar(15)
  email          String   @unique
  senha          String
  dataNascimento DateTime @db.Date
  genero         String
  status         String   @default("ativo")
  createdAt      DateTime @default(now()) @map("created_at")

  abrigoId Int?
  abrigo   Abrigo? @relation(fields: [abrigoId], references: [id_abrigo])

  solicitacoesAjudaAtendidas SolicitacaoAjuda[]
  interessesAjuda            SolicitacaoAjudaInteresse[]

  @@map("voluntario")
}

// ─────────────────────────────────────────────
// SOLICITAÇÃO DE ABRIGO
// ─────────────────────────────────────────────

enum StatusSolicitacao {
  pendente
  aprovado
  recusado
}

model SolicitacaoAbrigo {
  id_solicitacao Int @id @default(autoincrement())

  nome                    String
  cep                     String  @db.VarChar(9)
  endereco                String
  cidade                  String
  estado                  String
  bairro                  String
  telefone                String? @db.VarChar(15)
  responsavel             String
  tipoAbrigo              String
  capacidadeTotal         Int
  possuiAtendimentoMedico Boolean @default(false)
  possuiEnfermagem        Boolean @default(false)
  possuiPets              Boolean @default(false)
  possuiAcessibilidade    Boolean @default(false)
  possuiCozinha           Boolean @default(false)
  fotoAbrigo              String?

  solicitanteNome     String
  solicitanteEmail    String
  solicitanteTelefone String? @db.VarChar(15)

  status       StatusSolicitacao @default(pendente)
  motivoRecusa String?

  analisadoPorId Int?
  analisadoPor   Admin?    @relation(fields: [analisadoPorId], references: [id])
  dataAnalise    DateTime?

  abrigo_id Int?    @unique
  abrigo    Abrigo? @relation(fields: [abrigo_id], references: [id_abrigo])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("solicitacao_abrigo")
}

// ─────────────────────────────────────────────
// SOLICITAÇÃO DE AJUDA  (substitui Doacao)
// ─────────────────────────────────────────────

enum StatusSolicitacaoAjuda {
  aberto
  em_andamento
  concluido
  cancelado
}

enum CategoriaAjuda {
  doacao         // roupas, alimentos, itens em geral
  medicamento    // remédios, insumos médicos
  voluntariado   // mão de obra, serviços presenciais
  infraestrutura // reparos, equipamentos
  outro          // pedido livre / personalizado
}

enum UrgenciaAjuda {
  baixa
  media
  alta
  critica
}

model SolicitacaoAjuda {
  id_solicitacao Int @id @default(autoincrement())

  // Conteúdo livre — o ADM descreve o que precisa
  titulo    String
  descricao String
  categoria CategoriaAjuda
  urgencia  UrgenciaAjuda  @default(media)

  status StatusSolicitacaoAjuda @default(aberto)

  // Observação interna preenchida ao concluir ou cancelar
  observacaoFechamento String?

  // ADM que criou a solicitação
  criadoPorId Int
  criadoPor   Admin @relation("SolicitacoesAjudaCriadas", fields: [criadoPorId], references: [id])

  // Abrigo ao qual a solicitação pertence (sempre obrigatório)
  abrigoId Int
  abrigo   Abrigo @relation(fields: [abrigoId], references: [id_abrigo])

  // Voluntário que atendeu — preenchido opcionalmente ao concluir
  // Pode ficar nulo (anônimo ou sem vínculo)
  voluntarioId Int?
  voluntario   Voluntario? @relation(fields: [voluntarioId], references: [id_voluntario])

  interesses SolicitacaoAjudaInteresse[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt       @map("updated_at")

  @@index([status])
  @@index([abrigoId])
  @@index([categoria])
  @@index([createdAt])
  @@map("solicitacao_ajuda")
}

// Registro de interesse do voluntário
// — somente visual, sem poder de gestão
// — um voluntário não pode marcar interesse duas vezes na mesma solicitação
model SolicitacaoAjudaInteresse {
  id Int @id @default(autoincrement())

  solicitacaoId Int
  solicitacao   SolicitacaoAjuda @relation(fields: [solicitacaoId], references: [id_solicitacao])

  voluntarioId Int
  voluntario   Voluntario @relation(fields: [voluntarioId], references: [id_voluntario])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([solicitacaoId, voluntarioId])
  @@map("solicitacao_ajuda_interesse")
}

// FRAGMENTO: acrescente ao final de Backend/prisma/schema.prisma.
// Não substitui o schema existente; não contém generator nem datasource.
// Acrescente também os campos inversos de relacoes-existentes.prisma.txt.

enum TipoAlerta {
  inundacao
  deslizamento
  tempestade
  vento_forte
  outro
}

enum SeveridadeAlerta {
  baixa
  moderada
  alta
  critica
}

enum StatusAlerta {
  rascunho
  em_revisao
  publicado
  encerrado
  cancelado
}

enum AcaoHistoricoAlerta {
  criar
  editar
  enviar_revisao
  devolver_rascunho
  publicar
  encerrar
  cancelar
}

model Alerta {
  id_alerta   Int              @id @default(autoincrement())
  titulo      String           @db.VarChar(140)
  descricao   String           @db.Text
  orientacoes String           @db.Text
  tipo        TipoAlerta
  severidade  SeveridadeAlerta

  // A validade é um intervalo [inicioEm, expiraEm).
  // Publicado + datas produz agendado/ativo/expirado, sem tarefa agendada.
  status      StatusAlerta @default(rascunho)
  versao      Int          @default(1)
  inicioEm    DateTime     @db.Timestamptz(3)
  expiraEm    DateTime     @db.Timestamptz(3)
  publicadoEm DateTime?    @db.Timestamptz(3)
  fonteNome   String       @db.VarChar(160)
  fonteUrl    String?      @db.VarChar(2048)

  regiaoId Int
  regiao   Regiao @relation(fields: [regiaoId], references: [id_regiao], onDelete: Restrict)

  criadoPorId Int
  criadoPor   Admin @relation("AlertasCriados", fields: [criadoPorId], references: [id], onDelete: Restrict)

  historico HistoricoAlerta[]
  entregas  EntregaAlerta[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, inicioEm, expiraEm])
  @@index([regiaoId, status])
  @@index([severidade])
  @@index([criadoPorId])
  @@index([updatedAt])
  @@map("alerta")
}

model HistoricoAlerta {
  id         Int                  @id @default(autoincrement())
  alertaId   Int
  alerta     Alerta               @relation(fields: [alertaId], references: [id_alerta], onDelete: Restrict)
  atorId     Int
  ator       Admin                @relation("HistoricoAlertasAtor", fields: [atorId], references: [id], onDelete: Restrict)
  acao       AcaoHistoricoAlerta
  observacao String?              @db.Text
  versao     Int
  snapshot   Json
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  // Uma ação por versão; não há API para alterar/apagar o histórico.
  @@unique([alertaId, versao])
  @@index([alertaId, createdAt])
  @@index([atorId])
  @@map("historico_alerta")
}

// ESTRUTURA FUTURA: não existem endpoints nem processamento destes modelos.
// Criar as tabelas não significa que email/SMS/WhatsApp estão integrados.
enum CanalEntregaAlerta {
  email
  sms
  whatsapp
}

enum StatusEntregaAlerta {
  pendente
  enviada
  falha
  cancelada
}

model InscricaoAlerta {
  id                  Int                @id @default(autoincrement())
  regiaoId            Int
  regiao              Regiao             @relation(fields: [regiaoId], references: [id_regiao], onDelete: Restrict)
  canal               CanalEntregaAlerta
  destino             String             @db.VarChar(320)
  severidadeMinima    SeveridadeAlerta   @default(baixa)
  ativa               Boolean            @default(true)
  consentidoEm        DateTime           @db.Timestamptz(3)
  canceladaEm         DateTime?          @db.Timestamptz(3)
  // Armazenar somente hash de token aleatório; nunca o token em texto puro.
  cancelamentoTokenHash String?          @unique @db.VarChar(128)
  entregas            EntregaAlerta[]
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([regiaoId, canal, destino])
  @@index([regiaoId, ativa, severidadeMinima])
  @@map("inscricao_alerta")
}

model EntregaAlerta {
  id                 Int                 @id @default(autoincrement())
  alertaId           Int
  alerta             Alerta              @relation(fields: [alertaId], references: [id_alerta], onDelete: Restrict)
  inscricaoId        Int
  inscricao          InscricaoAlerta     @relation(fields: [inscricaoId], references: [id], onDelete: Restrict)
  versaoAlerta       Int
  status             StatusEntregaAlerta @default(pendente)
  tentativas         Int                 @default(0)
  proximaTentativaEm DateTime?           @db.Timestamptz(3)
  ultimaTentativaEm  DateTime?           @db.Timestamptz(3)
  enviadaEm          DateTime?           @db.Timestamptz(3)
  provedorReferencia String?             @db.VarChar(255)
  ultimoErro         String?             @db.Text
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Evita duplicar o mesmo envio ao mesmo destinatário e versão.
  @@unique([alertaId, inscricaoId, versaoAlerta])
  @@index([status, proximaTentativaEm])
  @@index([inscricaoId])
  @@map("entrega_alerta")
}
