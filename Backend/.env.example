# Banco PostgreSQL (Supabase)
DATABASE_URL=
DIRECT_URL=

# Chave para assinar os tokens de login
JWT_SECRET=

# Storage de fotos (buckets: fotos-abrigo, fotos-vitima, fotos-alerta)
SUPABASE_URL=
SUPABASE_KEY=

# Chave compartilhada com o ChatBot (mesmo valor no ChatBot/.env)
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_API_KEY=

# Opcionais — sistema de alertas
# Relatos de pessoas diferentes necessários para disparar um alerta (padrão 3)
# ALERTA_CONFIRMACOES_MINIMAS=3
# Relatos só se juntam a um alerta em verificação aberto nas últimas X horas (padrão 6)
# ALERTA_JANELA_HORAS=6
