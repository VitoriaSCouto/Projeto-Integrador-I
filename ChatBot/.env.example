# Mesmo valor do BOT_API_KEY do Backend/.env
BOT_API_KEY=

# Opcionais
# Endereço da API (padrão http://localhost:3000)
# API_URL=http://localhost:3000
# De quantos em quantos ms o bot procura alertas para enviar (padrão 15000)
# NOTIFICACOES_INTERVALO_MS=15000
# Pausa entre uma mensagem e outra, para o WhatsApp não bloquear o número (padrão 2000)
# NOTIFICACOES_PAUSA_MS=2000
