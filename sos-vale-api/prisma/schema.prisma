generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id          Int      @id @default(autoincrement())
  nome        String
  email       String   @unique
  senha       String
  cargo       String   @default("operador")
  orgao       String?
  nivelAcesso String   @default("operador")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("admin")
}

model Abrigo {
  id                      Int      @id @default(autoincrement())
  nome                    String
  endereco                String
  telefone                String?
  responsavel             String
  tipoAbrigo              String
  capacidadeTotal         Int
  capacidadeOcupada       Int      @default(0)
  possuiAtendimentoMedico Boolean  @default(false)
  status                  String   @default("ativo")
  createdAt               DateTime @default(now()) @map("created_at")

  @@map("abrigo")
}

model Regiao {
  id                Int      @id @default(autoincrement())
  bairro            String   // era nome
  cidade            String
  estado            String
  populacaoEstimada Int?
  areaKm2           Float?
  nivelRisco        String   @default("baixo")
  statusAlerta      Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("regiao")
}

model Vitima {
  id_vitima      Int      @id @default(autoincrement())
  nome           String
  cpf            String?  @default("Ainda não informado")
  telefone       String?  @unique @default("Ainda não informado")
  dataNascimento DateTime @db.Date
  genero         String
  fotoPerfil     String?

  deficiencias VitimaDeficiencia[]
  createdAt         DateTime @default(now()) @map("created_at")
}

model Deficiencia {
  id_deficiencia Int    @id @default(autoincrement())
  nome           String @unique

  vitimas VitimaDeficiencia[]
}

model VitimaDeficiencia {
  id_vitima      Int
  id_deficiencia Int

  vitima      Vitima      @relation(fields: [id_vitima], references: [id_vitima])
  deficiencia Deficiencia @relation(fields: [id_deficiencia], references: [id_deficiencia])

  @@id([id_vitima, id_deficiencia])
}